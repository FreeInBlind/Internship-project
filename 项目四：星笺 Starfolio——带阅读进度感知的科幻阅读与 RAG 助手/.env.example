# DeepSeek official generation API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Cohere official API (server-side only; restart Next.js after changes)
# Trial is preferred; production is used on confirmed trial billing-limit exhaustion.
COHERE_TRIAL_API_KEY=
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_EMBED_DIMENSIONS=1024
COHERE_RERANK_MODEL=rerank-v3.5

# Neon PostgreSQL (server-side only; never use NEXT_PUBLIC_)
# Keep the existing connection string. The app, Drizzle and migration tooling read DATABASE_URL.
DATABASE_URL=

# Better Auth (server-side only). Generate a random secret of at least 32 characters.
# Use this exact origin in the browser; localhost and 127.0.0.1 are different origins.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=

# Pinecone vector index
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=starfolio-cohere-v1
