generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
  schemas  = ["public"]
}

model User {
  id             String        @id @default(cuid())
  normalizedEmail String       @unique
  passwordHash   String
  createdAt      DateTime      @default(now())
  savedReports   SavedReport[]
  analysisAttempts AnalysisAttempt[]
  aiConfig         AiConfig?

  @@map("User")
  @@schema("public")
}

model AiConfig {
  userId        String   @id
  baseUrl       String
  model         String
  ciphertext    String
  nonce         String
  tag           String
  keyVersion    Int
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AiConfig")
  @@schema("public")
}

model AuthRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  @@index([windowStart])
  @@map("AuthRateLimit")
  @@schema("public")
}

model OfficialQuotaDay {
  dayKey    DateTime @id @db.Date
  reserved  Int      @default(0)
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("OfficialQuotaDay")
  @@schema("public")
}

model AnalysisAttempt {
  id            String   @id
  userId        String
  requestId     String
  requestHash   String
  dayKey        DateTime @db.Date
  status        String
  leaseToken    String
  leaseExpiresAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([status, leaseExpiresAt])
  @@index([dayKey, status])
  @@map("AnalysisAttempt")
  @@schema("public")
}

model SavedReport {
  id                    String   @id @default(cuid())
  userId                String
  title                 String
  confirmedResumeText   String
  jobTitle              String
  optionalJd            String?
  education             String
  salary                String?
  reportLanguage        String
  editedMarkdown        String
  reportJson            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  expiresAt             DateTime
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("SavedReport")
  @@schema("public")
}
