# Server-only PostgreSQL connections. Neon target and migration status are not verified.
# DATABASE_URL should use the pooled endpoint for application runtime.
DATABASE_URL=
# DATABASE_URL_UNPOOLED should use the direct endpoint for Prisma migrations and integration tests.
DATABASE_URL_UNPOOLED=
# Required for authentication and rate-limit key derivation; keep private.
NEXTAUTH_SECRET=
# Public application origin. Local development uses http://127.0.0.1:3010.
# For deployment, replace this with the actual HTTPS public origin.
NEXTAUTH_URL=http://127.0.0.1:3010
# Optional runtime settings. PORT is not part of the public origin behind a proxy.
# PORT=3010
# APP_HOST=127.0.0.1
# Set APP_HOST=0.0.0.0 explicitly only when required by your deployment environment.
# Set to 1 only behind a correctly configured trusted proxy.
# TRUST_PROXY=1
# Server-only Groq credentials; never use NEXT_PUBLIC_ for these values.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Keep both switches unset/false until the quota migration and live-call approvals are complete.
# GROQ_UPSTREAM_ENABLED=false
# GROQ_QUOTA_MIGRATION_ENABLED=false
# Optional account-level personal AI config encryption key. Generate separately only after approval.
# Exactly 32 random bytes encoded as canonical standard Base64 (44 chars, one trailing =).
# Do not reuse NEXTAUTH_SECRET or any provider key. Never put a real value in this example.
CUSTOM_AI_ENCRYPTION_KEY=
# Optional scheduled cleanup authentication secret; configure only after separate approval.
# CRON_SECRET=
